.g-panel-body { flex-grow: 1; min-height: 0; }
.g-panel-row { flex-direction: row; align-items: center; }
.g-panel-column { flex-direction: column; }
.g-panel-card { background-color: var(--sd); border-radius: 22px; padding: 18px; }
.g-panel-spacer { flex-grow: 1; }
.g-panel-muted { color: var(--mt); }
.g-panel-wrap { white-space: normal; }
.g-panel-input { flex-grow: 1; height: 48px; margin: 0; padding: 0; }
.g-panel-input > .unity-text-field__input { background-color: var(--dp); border-radius: 14px; color: #f4f1e8; padding: 0 14px; border-width: 0; font-size: 15px; -unity-text-align: middle-left; }
.g-panel-input:focus > .unity-text-field__input { border-width: 2px; border-color: var(--a1); padding: 0 12px; }
.g-panel-input.invalid > .unity-text-field__input { border-width: 2px; border-color: #ff5e6c; padding: 0 12px; }
.g-panel-input.bare > .unity-text-field__input, .g-panel-input.bare:focus > .unity-text-field__input { background-color: transparent; border-width: 0; padding: 0; }
.g-panel-input > .unity-text-field__input.unity-base-text-field__input--placeholder { color: var(--mt); }
.g-panel-small-button { min-width: 104px; height: 40px; padding: 8px 18px; font-size: 14px; }
.g-panel-code { background-color: var(--dp); border-radius: 14px; border-width: 1px; border-color: var(--bd); padding: 10px 14px; }
.g-panel-selected { border-color: var(--a1); border-width: 2px; }
.g-friend-row { background-color: var(--sd); border-radius: 18px; padding: 12px 16px; margin-bottom: 8px; min-height: 72px; flex-shrink: 0; transition-property: background-color; transition-duration: .15s; }
.g-friend-row:hover { background-color: var(--pnH); }
.g-settings { flex-direction: row; width: 900px; height: 560px; }
.g-settings-sidebar { width: 230px; flex-shrink: 0; background-color: var(--sd); padding: 22px 14px; border-right-width: 1px; border-right-color: rgba(255,255,255,.06); }
.g-settings-title { padding: 0 10px 16px; flex-shrink: 0; }
.g-settings-nav { height: 44.4px; margin-top: 6px; padding: 12px 14px; border-radius: 14px; background-color: transparent; border-width: 0; color: var(--mt); font-size: 17px; -unity-text-align: middle-left; align-items: center; flex-shrink: 0; transition-property: background-color; transition-duration: .15s; }
.g-settings-nav > .heading { color: var(--mt); transition-property: color; transition-duration: .15s; }
.g-settings-nav:hover { background-color: var(--pnH); }
.g-settings-nav:hover > .heading, .g-settings-nav.selected > .heading { color: #f4f1e8; }
.g-settings-nav.selected { background-color: transparent; }
.g-settings-nav:hover, .g-settings-nav:active, .g-settings-nav:focus { translate: 0 0; scale: 1 1; }
.keyboard-navigation .galaxy-button.g-settings-nav:focus { border-width: 0; background-color: var(--pnH); }
.g-settings-nav-bar, .g-inset-bar { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.g-settings-nav-face, .g-inset-bar-face { position: absolute; left: 4px; top: 0; right: -4px; bottom: 0; }
.g-settings-credits { padding: 0 12px; opacity: .7; flex-shrink: 0; }
.g-settings-credits > .body { height: 18px; -unity-text-align: middle-left; white-space: nowrap; }
.g-settings-content { flex-grow: 1; min-width: 0; }
.g-settings-heading { padding: 22px 28px 14px; flex-shrink: 0; }
.g-settings-list { flex-grow: 1; padding-left: 28px; padding-right: 20px; min-height: 0; }
.g-settings-row { padding: 10px 0; min-height: 62px; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,.07); flex-shrink: 0; }
.g-step-arrow { background-color: transparent; }
.g-settings-footer { padding: 16px 28px; background-color: rgba(0,0,0,.12); border-top-width: 1px; border-top-color: rgba(255,255,255,.07); flex-shrink: 0; }
.g-toggle { width: 56px; height: 32px; min-width: 56px; border-radius: 16px; padding: 0; margin: 0; border-width: 0; background-color: var(--dp); }
.g-toggle.on { background-color: #3ccb6e; }
.g-toggle-knob { position: absolute; left: 3px; top: 3px; width: 26px; height: 26px; border-radius: 13px; background-color: white; transition-property: left; transition-duration: .22s; transition-timing-function: ease-out-back; }
.g-toggle.on .g-toggle-knob { left: 27px; }
.g-toggle:hover, .g-toggle:active, .g-settings-nav:hover, .g-rule-nav:hover, .g-segment-button:hover, .g-language-card:hover { translate: 0 0; }
.g-slider { width: 270px; height: 34px; padding-left: 12px; padding-right: 12px; justify-content: center; flex-shrink: 0; }
.g-slider-track { height: 12px; border-radius: 6px; background-color: var(--dp); }
.g-slider-fill { height: 12px; border-radius: 6px; }
.g-slider-knob { position: absolute; width: 26px; height: 26px; top: -7px; margin-left: -13px; border-radius: 13px; background-color: #f4f5fc; align-items: center; justify-content: center; }
.g-slider.dragging .g-slider-knob { scale: 1.06 1.06; border-width: 4px; border-color: var(--gl); }
.g-slider-dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--a1); }
.g-slider-value { min-width: 58px; background-color: var(--dp); border-radius: 10px; padding: 5px 10px; -unity-text-align: middle-center; }
.g-segment { flex-direction: row; background-color: var(--dp); padding: 4px; border-radius: 14px; }
.g-segment-button { padding: 8px 14px; border-width: 0; border-radius: 10px; margin: 0; background-color: transparent; color: var(--mt); font-size: 14px; }
.g-segment-button.selected { color: var(--aT); background-color: var(--a2); }
.g-language-card { flex-grow: 1; flex-basis: 0; padding: 17px; border-radius: 20px; background-color: var(--sd); border-width: 1px; border-color: rgba(255,255,255,.08); -unity-text-align: middle-left; }
.g-language-card.selected { border-width: 2px; padding: 16px; border-color: var(--a1); }
.g-language-card:hover { background-color: var(--pnH); }
.g-language-card:active { translate: 0 0; }
.g-shop-deal { height: 96px; flex-shrink: 0; padding: 16px 22px; border-radius: 22px; margin-bottom: 16px; }
.g-shop-product { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 22px 14px 14px; border-radius: 22px; background-color: var(--sd); border-width: 2px; border-color: transparent; position: relative; align-items: center; transition-property: translate, background-color; transition-duration: .18s; }
.g-shop-product:hover { translate: 0 -5px; background-color: var(--pnH); }
.g-shop-product.popular { border-color: var(--a1); }
.g-shop-art { height: 104px; width: 100%; align-items: center; justify-content: center; }
.g-shop-popular { position: absolute; top: -1px; align-self: center; padding: 5px 14px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; background-color: var(--a1); color: var(--aT); font-size: 9px; letter-spacing: 11.1px; }
.g-shop-bonus { position: absolute; right: 12px; top: 12px; padding: 3px 7px; border-radius: 7px; background-color: #3ccb6e; color: white; font-size: 10px; }
.g-shop-price { align-self: stretch; margin-top: 16px; height: 42px; }
.g-leader-header { height: 22px; padding: 0 16px 4px 16px; margin-bottom: 6px; align-items: flex-start; flex-shrink: 0; }
.g-leader-row { padding: 8px 16px; background-color: var(--sd); border-radius: 14px; margin-bottom: 6px; flex-shrink: 0; }
.g-leader-self { padding: 10px 16px; border-radius: 16px; margin-top: 8px; }
.g-day { height: 120px; padding: 10px 8px; border-radius: 18px; background-color: var(--sd); flex-grow: 1; flex-basis: 0; align-items: center; justify-content: space-between; }
.g-quest { padding: 9px 14px; margin-bottom: 8px; border-radius: 16px; background-color: var(--sd); min-height: 54px; flex-shrink: 0; }
.g-rule-nav { padding: 11px 14px; margin-bottom: 6px; border-radius: 14px; background-color: transparent; border-width: 0; height: 50px; color: var(--mt); font-size: 16px; -unity-text-align: middle-left; }
.g-rule-nav:hover { background-color: var(--pnH); }
.g-rule-nav.selected { background-color: transparent; color: #f4f1e8; }
.g-rule-nav > .heading { color: var(--mt); }
.g-rule-nav:hover > .heading, .g-rule-nav.selected > .heading { color: #f4f1e8; }
.g-rule-nav:active, .g-rule-nav:focus { translate: 0 0; }
.keyboard-navigation .galaxy-button.g-rule-nav:focus { border-width: 0; background-color: var(--pnH); }
.g-profile-stat { background-color: var(--sd); border-radius: 18px; padding: 14px; flex-grow: 1; flex-basis: 0; min-width: 0; }
.g-profile-badge { padding: 14px; border-radius: 18px; background-color: var(--sd); align-items: center; flex-grow: 1; flex-basis: 0; min-width: 0; }
.g-dialog { padding: 22px 24px 24px; }
.g-dialog-header { margin-bottom: 20px; flex-shrink: 0; }
.g-dialog-footer { padding-top: 16px; margin-top: 20px; border-top-width: 1px; border-top-color: rgba(255,255,255,.07); }
.g-dialog-title { -unity-text-align: middle-center; }
.g-edit-preview { width: 220px; padding: 18px; border-radius: 20px; background-color: var(--sd); align-items: center; flex-shrink: 0; }
.g-edit-swatch { width: 28px; height: 28px; min-width: 28px; padding: 0; margin: 4px; border-radius: 14px; border-width: 2px; border-color: transparent; }
.g-edit-swatch.selected { border-color: white; }
.g-share-card { height: 180px; border-radius: 22px; padding: 20px; overflow: hidden; }
.g-share-target { flex-grow: 1; flex-basis: 0; align-items: center; padding: 14px 8px 10px; border-radius: 18px; background-color: var(--sd); border-width: 0; margin: 0; transition-property: translate, background-color; transition-duration: .15s; }
.g-share-target:hover { translate: 0 -4px; }
.g-losses { padding: 14px 16px; border-radius: 14px; background-color: rgba(255,94,108,.1); border-width: 1px; border-color: rgba(255,94,108,.22); margin-top: 16px; margin-bottom: 16px; }
