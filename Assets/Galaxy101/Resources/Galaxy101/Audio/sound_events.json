{
 "version": "0.4.0",
 "source": "pkg/sound/events.json (g101-sound.js (oyunda çalışan katalog)) + pkg/sound/README.md + prototip/g101-sound.js",
 "format": "WAV · 44 100 Hz · 16 bit · stereo",
 "categories": {
  "ui": "arayüz",
  "game": "oyun akışı",
  "tile": "taş (ayar: tileSnd)",
  "chat": "sohbet, ikram, hediye (ayar: chatSnd / notifSnd)",
  "music": "müzik (ayar: music)"
 },
 "channels": {
  "ui": "sfx",
  "game": "sfx",
  "tile": "sfx",
  "chat": "sfx",
  "music": "music"
 },
 "toggles": {
  "tile": [
   "tileSnd"
  ],
  "chat": [
   "chatSnd",
   "notifSnd"
  ]
 },
 "volume": {
  "rule": "kazanç = master/100 × (müzikse music, değilse sfx)/100; kategori anahtarı kapalıysa 0. Varsayılan master 80, sfx 90, music 55.",
  "defaults": {
   "master": 80,
   "sfx": 90,
   "music": 55,
   "tileSnd": true,
   "chatSnd": true,
   "notifSnd": true
  },
  "settings": {
   "master": "Ana ses",
   "sfx": "Efektler",
   "music": "Müzik",
   "tileSnd": "Taş sesleri",
   "chatSnd": "Sohbet sesleri",
   "notifSnd": "Bildirim sesleri"
  },
  "opponentDrawVolume": 0.7
 },
 "mixing": {
  "text": {
   "duck": "prio ≥ 5 (penalty, finish, finish.nuke) çalınca müzik %40'a iner (0,3 sn), 2,4 sn'de geri gelir",
   "poly": "aynı olaydan eş zamanlı en çok poly kopya",
   "crossfade": "menü ↔ masa müziği 1,2 sn geçiş",
   "sync": "dice.roll 1450 ms, nuke 1750 ms, rocket 5600 ms (anim/ ve protocol/timings.md ile aynı)"
  },
  "duck": {
   "minPrio": 5,
   "musicLevel": 0.4,
   "downSeconds": 0.3,
   "restoreAtSeconds": 2.4
  },
  "crossfadeOutSeconds": 1.2,
  "fadeInSeconds": 1.5,
  "sync": {
   "dice.roll": 1450,
   "finish.nuke": 1750,
   "gift.rocket": 5600
  }
 },
 "engineEvents": {
  "drew": {
   "sound": "tile.draw",
   "rule": "ben ya da rakip; rakipte opponentDrawVolume"
  },
  "discarded": {
   "sound": "tile.discard"
  },
  "opened": {
   "sound": "meld.lay"
  },
  "laid": {
   "sound": "meld.lay"
  },
  "added": {
   "sound": "meld.add"
  },
  "okeySwapped": {
   "sound": "okey.swap"
  },
  "penalty": {
   "sound": "penalty"
  },
  "finished": {
   "sound": [
    "finish",
    "finish.nuke"
   ],
   "rule": "okeyle / elden bitiş fırlatması (nuke) → finish.nuke, değilse finish"
  },
  "handEnd": {
   "sound": "hand.end"
  },
  "turn": {
   "sound": "turn.mine",
   "rule": "seat = ben, dağıtım bitince"
  },
  "dealStart": {
   "sound": "deal.shuffle"
  },
  "dealDie": {
   "sound": "dice.roll"
  },
  "dealStep": {
   "sound": [
    "deal.indicator",
    "deal.distribute"
   ],
   "rule": "indicator → deal.indicator, distribute → deal.distribute"
  },
  "gift": {
   "sound": [
    "gift.send",
    "gift.receive",
    "gift.rocket"
   ],
   "rule": "uçuş başladı → gift.send (roket: gift.rocket); sana geldi → gift.receive"
  },
  "chat": {
   "sound": "chat.message",
   "rule": "rakipten mesaj/balon"
  }
 },
 "screenMusic": {
  "game": "music.table",
  "*": "music.menu"
 },
 "screenChange": {
  "sound": "ui.screen",
  "skipFrom": [
   "splash"
  ]
 },
