    m_Localized: SV 30
    m_Metadata:
      m_Items: []
  - m_Id: 967102612
    m_Localized: "Ad\u0131n\u0131 30 g\xFCnde bir de\u011Fi\u015Ftirebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102613
    m_Localized: "S\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 967102614
    m_Localized: "Hesab\u0131n\u0131 silmek istiyor musun?"
    m_Metadata:
      m_Items: []
  - m_Id: 967102615
    m_Localized: "\xC7\u0131k\u0131\u015F yapmak istiyor musun?"
    m_Metadata:
      m_Items: []
  - m_Id: 967102616
    m_Localized: "Hesab\u0131n 30 g\xFCn sonra kal\u0131c\u0131 olarak silinir. Bu s\xFCre i\xE7inde giri\u015F yaparsan silme i\u015Flemi iptal olur."
    m_Metadata:
      m_Items: []
  - m_Id: 967102617
    m_Localized: "\xC7iplerin, ilerlemen ve arkada\u015Flar\u0131n Google hesab\u0131nda saklan\u0131r. \u0130stedi\u011Fin zaman tekrar giri\u015F yapabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102618
    m_Localized: "Onaylamak i\xE7in ${word} yaz"
    m_Metadata:
      m_Items: []
  - m_Id: 967102619
    m_Localized: "Hesab\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 967102620
    m_Localized: "\xC7\u0131k\u0131\u015F yap"
    m_Metadata:
      m_Items: []
  - m_Id: 967102621
    m_Localized: "Silme talebin al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102622
    m_Localized: "\xC7\u0131k\u0131\u015F yap\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102623
    m_Localized: "30 g\xFCn i\xE7inde giri\u015F yaparak iptal edebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102624
    m_Localized: "Masada g\xF6r\xFC\u015Fmek \xFCzere."
    m_Metadata:
      m_Items: []
  - m_Id: 967102625
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 967102626
    m_Localized: "Arkada\u015F kodu veya oyuncu ad\u0131yla ara"
    m_Metadata:
      m_Items: []
  - m_Id: 967102627
    m_Localized: "\xD6rn. MK-3321"
    m_Metadata:
      m_Items: []
  - m_Id: 967102628
    m_Localized: Ara
    m_Metadata:
      m_Items: []
  - m_Id: 967102629
    m_Localized: Kod ya da ad girip Ara'ya bas.
    m_Metadata:
      m_Items: []
  - m_Id: 967102630
    m_Localized: "Bu oyuncuyla zaten arkada\u015Fs\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 967102631
    m_Localized: "Oyuncu bulunamad\u0131. Kodu kontrol edip tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 967102632
    m_Localized: "\u0130stek g\xF6nderildi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102633
    m_Localized: "\u0130stek g\xF6nder"
    m_Metadata:
      m_Items: []
  - m_Id: 967102634
    m_Localized: "Kopyaland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102635
    m_Localized: Kopyala
    m_Metadata:
      m_Items: []
  - m_Id: 967102636
    m_Localized: "Di\u011Fer"
    m_Metadata:
      m_Items: []
  - m_Id: 967102637
    m_Localized: "Profil kart\u0131n\u0131 arkada\u015Flar\u0131na g\xF6nder"
    m_Metadata:
      m_Items: []
  - m_Id: 967102638
    m_Localized: Sezon 3
    m_Metadata:
      m_Items: []
  - m_Id: 967102639
    m_Localized: EL
    m_Metadata:
      m_Items: []
  - m_Id: 967102640
    m_Localized: KAZANMA
    m_Metadata:
      m_Items: []
  - m_Id: 967102641
    m_Localized: "EN \u0130Y\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 967102642
    m_Localized: "Profil ba\u011Flant\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102643
    m_Localized: "\u015Eununla payla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102644
    m_Localized: "Ba\u011Flant\u0131y\u0131 kopyala"
    m_Metadata:
      m_Items: []
  - m_Id: 967102645
    m_Localized: "${name} a\xE7\u0131l\u0131yor\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 967102646
    m_Localized: "Arkada\u015F\u0131n\u0131 davet et, \xE7ip kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 967102647
    m_Localized: "Ba\u011Flant\u0131nla gelen arkada\u015F\u0131n ilk elini oynay\u0131nca ikiniz de 2.000 \xE7ip kazan\u0131rs\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 967102648
    m_Localized: "'\xC7ip', 'Elmas', 'G\xF6r\xFCn\xFCm'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102649
    m_Localized: "'Haftal\u0131k', 'Sezon', 'Arkada\u015Flar'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102650
    m_Localized: "'Genel', 'Rozetler', 'Ma\xE7 ge\xE7mi\u015Fi'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102651
    m_Localized: "'Klasik', 'Alt\u0131n', 'Galaksi'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102652
    m_Localized: "'Klasik', 'Alt\u0131n', 'Galaksi'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102653
    m_Localized: "'125.400 \xE7ip ve 340 elmas', 'Seviye 24, Alt\u0131n II derecesi ve rozetler', 'Arkada\u015F listesi ve ma\xE7 ge\xE7mi\u015Fi'"
    m_Metadata:
      m_Items: []
  - m_Id: 967102654
    m_Localized: "\xC7ip"
    m_Metadata:
      m_Items: []
  - m_Id: 967102655
    m_Localized: Elmas
    m_Metadata:
      m_Items: []
  - m_Id: 967102656
    m_Localized: "G\xF6r\xFCn\xFCm"
    m_Metadata:
      m_Items: []
  - m_Id: 967102657
    m_Localized: "Haftal\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 967102658
    m_Localized: Sezon
    m_Metadata:
      m_Items: []
  - m_Id: 967102659
    m_Localized: Genel
    m_Metadata:
      m_Items: []
  - m_Id: 967102660
    m_Localized: Rozetler
    m_Metadata:
      m_Items: []
  - m_Id: 967102661
    m_Localized: "Ma\xE7 ge\xE7mi\u015Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102662
    m_Localized: Klasik
    m_Metadata:
      m_Items: []
  - m_Id: 967102663
    m_Localized: "Alt\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 967102664
    m_Localized: Galaksi
    m_Metadata:
      m_Items: []
  - m_Id: 967102665
    m_Localized: "125.400 \xE7ip ve 340 elmas"
    m_Metadata:
      m_Items: []
  - m_Id: 967102666
    m_Localized: "Seviye 24, Alt\u0131n II derecesi ve rozetler"
    m_Metadata:
      m_Items: []
  - m_Id: 967102667
    m_Localized: "Arkada\u015F listesi ve ma\xE7 ge\xE7mi\u015Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102668
    m_Localized: "De\u011Fi\u015Fiklikler kaydedilemedi. Tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 967102669
    m_Localized: "\xC7evrimi\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 967102670
    m_Localized: "T\xFCm\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 967102671
    m_Localized: "\u0130stekler"
    m_Metadata:
      m_Items: []
  - m_Id: 967102672
    m_Localized: "Masa a\xE7\u0131lamad\u0131. Yeniden deneyin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102673
    m_Localized: ' sn'
    m_Metadata:
      m_Items: []
  - m_Id: 967102674
    m_Localized: "\u0130\u015Flem tamam"
    m_Metadata:
      m_Items: []
  - m_Id: 967102675
    m_Localized: Yetersiz elmas
    m_Metadata:
      m_Items: []
  - m_Id: 967102676
    m_Localized: Tekli
    m_Metadata:
      m_Items: []
  - m_Id: 967102677
    m_Localized: "Tekli \xB7 101 \xB7 5K masa"
    m_Metadata:
      m_Items: []
  - m_Id: 967102678
    m_Localized: "E\u015Fli"
    m_Metadata:
      m_Items: []
  - m_Id: 967102679
    m_Localized: "E\u015Fli \xB7 101 \xB7 5K masa"
    m_Metadata:
      m_Items: []
  - m_Id: 967102680
    m_Localized: "Katlamal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102681
    m_Localized: "Katlamal\u0131 \xB7 101 \xB7 10K masa"
    m_Metadata:
      m_Items: []
  - m_Id: 967102682
    m_Localized: Dereceli
    m_Metadata:
      m_Items: []
  - m_Id: 967102683
    m_Localized: "Dereceli \xB7 Alt\u0131n II"
    m_Metadata:
      m_Items: []
  - m_Id: 967102684
    m_Localized: "Botlara kar\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102685
    m_Localized: "Botlara kar\u015F\u0131 \xB7 antrenman"
    m_Metadata:
      m_Items: []
  - m_Id: 967102686
    m_Localized: "\xD6zel oda"
    m_Metadata:
      m_Items: []
  - m_Id: 967102687
    m_Localized: "\xD6zel oda \xB7 \u015Fifreli"
    m_Metadata:
      m_Items: []
  - m_Id: 967102688
    m_Localized: "Ta\u015Flar ve okey"
    m_Metadata:
      m_Items: []
  - m_Id: 967102689
    m_Localized: "Oyunda 106 ta\u015F var: k\u0131rm\u0131z\u0131, sar\u0131, mavi ve siyah renklerde 1'den 13'e kadar iki\u015Fer ta\u015F ve 2 sahte okey."
    m_Metadata:
      m_Items: []
  - m_Id: 967102690
    m_Localized: "Ortadan a\xE7\u0131lan ta\u015F g\xF6stergedir. G\xF6stergenin bir \xFCst\xFC okeydir ve her ta\u015F\u0131n yerine ge\xE7ebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 967102691
    m_Localized: "Sahte okey, okeyin kendisi yerine kullan\u0131l\u0131r; de\u011Feri okeyin de\u011Feridir."
    m_Metadata:
      m_Items: []
  - m_Id: 967102692
    m_Localized: "G\xF6sterge sar\u0131 7 ise okey sar\u0131 8 olur."
    m_Metadata:
      m_Items: []
  - m_Id: 967102693
    m_Localized: "Da\u011F\u0131t\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 967102694
    m_Localized: "Ta\u015Flar kar\u0131\u015Ft\u0131r\u0131l\u0131r ve her oyuncuya 21 ta\u015F da\u011F\u0131t\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102695
    m_Localized: "Oyunu ba\u015Flatan oyuncu 22 ta\u015F al\u0131r ve ilk hamlede bir ta\u015F atarak ba\u015Flar."
    m_Metadata:
      m_Items: []
  - m_Id: 967102696
    m_Localized: "Kalan ta\u015Flar ortada \xE7ekme destesi olur. S\u0131ra saat y\xF6n\xFCn\xFCn tersine ilerler."
    m_Metadata:
      m_Items: []
  - m_Id: 967102697
    m_Localized: "Elini a\xE7mak"
    m_Metadata:
      m_Items: []
  - m_Id: 967102698
    m_Localized: "Elini a\xE7abilmek i\xE7in perlerinin toplam\u0131 en az 101 olmal\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 967102699
    m_Localized: "Seri: ayn\u0131 renkte en az 3 ard\u0131\u015F\u0131k ta\u015F. Grup: ayn\u0131 say\u0131da, farkl\u0131 renklerde 3 veya 4 ta\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 967102700
    m_Localized: "\u0130stersen en az 5 \xE7iftle \xE7iftten de a\xE7abilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102701
    m_Localized: "Seri 46 + grup 36 = 82 puan. A\xE7mak i\xE7in 19 puan daha gerekir."
    m_Metadata:
      m_Items: []
  - m_Id: 967102702
    m_Localized: "Ta\u015F i\u015Flemek"
    m_Metadata:
      m_Items: []
  - m_Id: 967102703
    m_Localized: "Elini a\xE7t\u0131ktan sonra masadaki t\xFCm perlere uygun ta\u015F ekleyebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102704
    m_Localized: "Masadaki bir perde okeyin yerini tutan ta\u015F sende varsa, onu koyup okeyi alabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102705
    m_Localized: "K\u0131rm\u0131z\u0131 13'\xFC masadaki k\u0131rm\u0131z\u0131 seriye i\u015Fleyebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 967102706
    m_Localized: Bitirmek
    m_Metadata:
      m_Items: []
  - m_Id: 967102707
    m_Localized: "Elindeki t\xFCm ta\u015Flar\u0131 perlere yerle\u015Ftirip son ta\u015F\u0131n\u0131 atan oyuncu eli bitirir."
    m_Metadata:
      m_Items: []
  - m_Id: 967102708
    m_Localized: "Son ta\u015F olarak okeyi atarak bitirirsen b\xFCt\xFCn cezalar ikiye katlan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102709
    m_Localized: "Son ta\u015F olarak okeyi atmak cezalar\u0131 ikiye katlar."
    m_Metadata:
      m_Items: []
  - m_Id: 967102710
    m_Localized: Puanlama
    m_Metadata:
      m_Items: []
  - m_Id: 967102711
    m_Localized: "Eli bitiren oyuncu -101 puan al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102712
    m_Localized: "Elini a\xE7an oyuncular ellerinde kalan ta\u015Flar\u0131n toplam\u0131 kadar ceza al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102713
    m_Localized: "Elini a\xE7amayan oyuncu 202 ceza al\u0131r. \xC7iftten a\xE7anlar\u0131n cezas\u0131 ikiye katlan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102714
    m_Localized: "Oyun sonunda en d\xFC\u015F\xFCk puana sahip oyuncu kazan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 967102715
    m_Localized: "G\xF6sterge"
    m_Metadata:
      m_Items: []
  - m_Id: 967102716
    m_Localized: Okey
    m_Metadata:
      m_Items: []
  - m_Id: 967102717
    m_Localized: "\u0130\u015Fle"
    m_Metadata:
      m_Items: []
  - m_Id: 967102718
    m_Localized: "Son ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102719
    m_Localized: Elmas I
    m_Metadata:
      m_Items: []
  - m_Id: 967102720
    m_Localized: Elmas II
    m_Metadata:
      m_Items: []
  - m_Id: 967102721
    m_Localized: Lobide
    m_Metadata:
      m_Items: []
  - m_Id: 967102722
    m_Localized: "Masada \xB7 E\u015Fli"
    m_Metadata:
      m_Items: []
  - m_Id: 967102723
    m_Localized: "Dereceli ma\xE7 ar\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 967102724
    m_Localized: "2 saat \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 967102725
    m_Localized: "3 g\xFCn \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 967102726
    m_Localized: "Ortak arkada\u015F: Ay\u015Fe Y."
    m_Metadata:
      m_Items: []
  - m_Id: 967102727
    m_Localized: "Son ma\xE7ta rakibindi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102728
    m_Localized: 3 el kazan
    m_Metadata:
      m_Items: []
  - m_Id: 967102729
    m_Localized: "\xC7iftten a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 967102730
    m_Localized: 5 el oyna
    m_Metadata:
      m_Items: []
  - m_Id: 967102731
    m_Localized: Okey atarak bitir
    m_Metadata:
      m_Items: []
  - m_Id: 967102732
    m_Localized: "40 ta\u015F i\u015Fle"
    m_Metadata:
      m_Items: []
  - m_Id: 967102733
    m_Localized: "\xC7ip, elmas ve ta\u015F g\xF6r\xFCn\xFCmleri"
    m_Metadata:
      m_Items: []
  - m_Id: 967102734
    m_Localized: "3 arkada\u015F\u0131n \xE7evrimi\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 967102735
    m_Localized: "Sezon 3 \xB7 biti\u015Fe 12 g\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 967102736
    m_Localized: "5 g\xFCnl\xFCk seri \xB7 her g\xFCn gir, \xF6d\xFCl b\xFCy\xFCs\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 967102737
    m_Localized: "\u0130statistikler, derece ve rozetler"
    m_Metadata:
      m_Items: []
  - m_Id: 967102738
    m_Localized: "101 Okey nas\u0131l oynan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 967102739
    m_Localized: "Sat\xFCrn"
    m_Metadata:
      m_Items: []
  - m_Id: 967102740
    m_Localized: "Alt\u0131n halkalar"
    m_Metadata:
      m_Items: []
  - m_Id: 967102741
    m_Localized: Mars
    m_Metadata:
      m_Items: []
  - m_Id: 967102742
    m_Localized: "K\u0131z\u0131l \xE7\xF6l"
    m_Metadata:
      m_Items: []
  - m_Id: 967102743
    m_Localized: "Nept\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 967102744
    m_Localized: Buz mavisi
    m_Metadata:
      m_Items: []
  - m_Id: 967102745
    m_Localized: "J\xFCpiter"
    m_Metadata:
      m_Items: []
  - m_Id: 967102746
    m_Localized: "F\u0131rt\u0131na ku\u015Faklar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102747
    m_Localized: "Ven\xFCs"
    m_Metadata:
      m_Items: []
  - m_Id: 967102748
    m_Localized: Pembe sis
    m_Metadata:
      m_Items: []
  - m_Id: 967102749
    m_Localized: "Galaksi ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102750
    m_Localized: "Alt\u0131n ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102751
    m_Localized: "Neon ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102752
    m_Localized: "Mermer ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102753
    m_Localized: "\u0130lk zafer"
    m_Metadata:
      m_Items: []
  - m_Id: 967102754
    m_Localized: "\u0130lk elini kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 967102755
    m_Localized: "Okey ustas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102756
    m_Localized: 50 kez okey atarak bitir
    m_Metadata:
      m_Items: []
  - m_Id: 967102757
    m_Localized: "5 \xE7ift"
    m_Metadata:
      m_Items: []
  - m_Id: 967102758
    m_Localized: "\xC7iftten 5 kez a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 967102759
    m_Localized: 100 el
    m_Metadata:
      m_Items: []
  - m_Id: 967102760
    m_Localized: 100 el oyna
    m_Metadata:
      m_Items: []
  - m_Id: 967102761
    m_Localized: "Katlama kral\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102762
    m_Localized: "Katlamal\u0131da 25 el kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 967102763
    m_Localized: Seri galibiyet
    m_Metadata:
      m_Items: []
  - m_Id: 967102764
    m_Localized: "\xDCst \xFCste 7 el kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 967102765
    m_Localized: Elmas lig
    m_Metadata:
      m_Items: []
  - m_Id: 967102766
    m_Localized: "Elmas lige y\xFCksel"
    m_Metadata:
      m_Items: []
  - m_Id: 967102767
    m_Localized: Galaksi gezgini
    m_Metadata:
      m_Items: []
  - m_Id: 967102768
    m_Localized: "T\xFCm gezegen temalar\u0131n\u0131 dene"
    m_Metadata:
      m_Items: []
  - m_Id: 967102769
    m_Localized: Efsane
    m_Metadata:
      m_Items: []
  - m_Id: 1802865266688
    m_Localized: 1.000 el kazan
    m_Metadata:
      m_Items: []
  - m_Id: 4283099828224
    m_Localized: 1.000 el kazan
    m_Metadata:
      m_Items: []
  references:
