<Project Sdk="Microsoft.NET.Sdk">
  <!-- The authoritative rules engine and bot planner, compiled from the same sources the Unity client uses. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Okey101.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)/Packages/com.okey101.core/Runtime/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(RepoRoot)/Assets/Okey101/Bots/BotPlanner.cs" Link="Bots/BotPlanner.cs" />
  </ItemGroup>
</Project>
