    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985492
    m_Localized: Bronz I
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985493
    m_Localized: "G\xFCm\xFC\u015F III"
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985494
    m_Localized: "G\xFCm\xFC\u015F II"
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985495
    m_Localized: "G\xFCm\xFC\u015F I"
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985496
    m_Localized: "Alt\u0131n III"
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985497
    m_Localized: Elmas III
    m_Metadata:
      m_Items: []
  - m_Id: 1595864885985498
