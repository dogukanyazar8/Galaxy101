.galaxy-root { flex-grow: 1; align-items: center; justify-content: center; background-color: var(--bg3); color: #f4f1e8; }
.galaxy-root .unity-base-text-field, .galaxy-root .unity-base-text-field__input { --unity-cursor-color: #f4f1e8; --unity-selection-color: rgba(51,143,255,.45); }
.galaxy-canvas { width: 1280px; height: 720px; position: relative; overflow: hidden; flex-shrink: 0; }
.fill { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.column { flex-direction: column; }
.heading { white-space: normal; margin: 0; padding: 0; }
.body { white-space: normal; margin: 0; padding: 0; }
.galaxy-button { margin: 0; padding: 10px 18px; border-width: 0; align-items: center; justify-content: center; flex-shrink: 0; transition-property: translate, scale, opacity; transition-duration: .15s; transition-timing-function: ease-out; }
.auth-raised { transition-property: translate; transition-duration: .12s; transition-timing-function: ease; }
.auth-hover-face { transition-property: opacity; transition-duration: .15s; transition-timing-function: ease; }
.auth-switch-track { transition-property: background-color; transition-duration: .2s; }
.auth-switch-thumb { transition-property: translate; transition-duration: .2s; transition-timing-function: ease-out-back; }
.auth-terms-fill { transition-property: opacity; transition-duration: .15s; }
.auth-cursor-root { transition-property: opacity; transition-duration: .18s; }
.auth-cursor-icon { opacity: 0; scale: .6 .6; rotate: 0deg; transition-property: opacity, scale, rotate; transition-duration: .12s, .22s, .22s; transition-timing-function: ease-out, ease-out-back, ease-out-back; }
.auth-cursor-icon.auth-cursor-active { opacity: 1; scale: 1 1; }
.auth-cursor-pointer.auth-cursor-active { scale: 1.06 1.06; rotate: -6deg; }
.auth-cursor-pointer.auth-cursor-active.auth-cursor-pressed { scale: .84 .84; rotate: -8deg; }
.auth-cursor-default.auth-cursor-active.auth-cursor-pressed, .auth-cursor-no.auth-cursor-active.auth-cursor-pressed { scale: .86 .86; }
.auth-cursor-grabbing.auth-cursor-active { scale: .96 .96; }
.auth-cursor-wait { transition-property: opacity, scale; transition-duration: .12s, .22s; transition-timing-function: ease-out, ease-out-back; }
/* Hover brightens (MenuView.Button); only the settings gear also rises, as in the design. */
.settings-button:hover { translate: 0 -2px; }
.galaxy-button:active { translate: 0 3px; }
.keyboard-navigation .galaxy-button:focus { border-width: 2px; border-color: rgba(255,255,255,.8); }
.galaxy-button:disabled { opacity: .55; }
.galaxy-button.plain { padding: 0; }
.top-bar { position: absolute; left: 0; right: 0; top: 0; padding: 16px 24px; flex-direction: row; align-items: center; }
.top-bar > * { margin-right: 14px; }
.top-bar > .settings-button { margin-right: 0; }
.top-name > .row { margin-top: 5px; }
.top-name .rank-diamond { margin-right: 10px; }
.rank-diamond { align-items: center; justify-content: center; flex-shrink: 0; }
.avatar { position: relative; }
.avatar-inner { align-items: center; justify-content: center; }
.avatar-stud { position: absolute; }
.avatar-button { transition-property: scale; transition-duration: .15s; }
.avatar-button:hover { scale: 1.06 1.06; }
.avatar-button:active { scale: 0.97 0.97; }
.avatar-level { position: absolute; bottom: -7px; align-self: center; padding: 1px 7px; white-space: nowrap; }
.currency-pill { flex-direction: row; align-items: center; padding: 5px 5px 5px 6px; }
.currency-pill > * { margin-right: 8px; }
.currency-pill > .currency-plus { margin-right: 0; }
.currency-icon.coin { width: 28px; height: 28px; }
.currency-icon.gem { width: 22px; height: 22px; margin-left: 2px; }
.currency-plus { width: 28px; height: 28px; padding: 0; border-radius: 14px; font-size: 20px; }
.currency-plus:hover { scale: 1.08 1.08; }
.settings-button { width: 46px; height: 46px; padding: 0; }
.logo-tile { align-items: center; padding-top: 8px; }
.play-host { transition-property: translate, scale; transition-duration: .12s; transition-timing-function: ease; }
.play-host:hover { translate: 0 -3px; scale: 1.02 1.02; }
.play-host.pressed { translate: 0 5px; scale: 1 1; }
.galaxy-button.play-button { padding: 0; flex-direction: column; transition-duration: 0s; }
.galaxy-button.play-button:hover, .galaxy-button.play-button:active { translate: 0 0; scale: 1 1; }
.mode-strip { flex-direction: row; }
.mode-slot { position: relative; flex-shrink: 0; }
/* Lift, scale, filters and ring are eased by MenuView.ModeCard (CSS: transform .2s cubic-bezier(.3,1.5,.6,1)); a USS
   transition here would also tween the filter list, which UI Toolkit's compositor cannot do. */
.mode-card { position: absolute; left: 0; top: 0; padding: 0 14px; align-items: flex-start; overflow: hidden; }
.galaxy-button.mode-card { transition-duration: 0s; }
/* Keyboard focus shows the card's own white ring (MenuView.ModeCard), not a border on the filtered card. */
.keyboard-navigation .galaxy-button.mode-card:focus { border-width: 0; }
.mode-glyph { position: absolute; right: -4px; bottom: -14px; }
.mode-tick { position: absolute; right: 8px; top: 8px; width: 22px; height: 22px; align-items: center; justify-content: center; }
.footer-navigation { flex-direction: row; align-items: flex-end; justify-content: center; }
.nav-button { margin-right: 22px; padding: 0; justify-content: flex-end; }
.nav-button:hover { translate: 0 -5px; }
.nav-square { width: 56px; height: 56px; align-items: center; justify-content: center; position: relative; }
.sale-badge { position: absolute; top: -7px; right: -14px; padding: 4px 6px; }
.notification-badge { position: absolute; top: -6px; right: -4px; min-width: 20px; height: 20px; -unity-text-align: middle-center; }
.planet-picker { position: absolute; left: 24px; bottom: 22px; }
.planet-pill { padding: 6px 16px 6px 6px; border-width: 1px; border-color: rgba(255,255,255,.12); }
.planet-orb { margin-right: 6px; }
.planet-orb:hover { scale: 1.15 1.15; }
.brand { position: absolute; right: 20px; bottom: 14px; }
.modal-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.modal-center { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.panel-card, .dialog-card { border-width: 1px; border-color: rgba(255,255,255,.1); }
.panel-header { padding: 20px 24px 16px; flex-shrink: 0; }
.panel-icon { width: 50px; height: 50px; flex-shrink: 0; align-items: center; justify-content: center; }
.panel-tabs { flex-direction: row; padding: 4px; margin-right: 14px; }
.galaxy-button.tab-button { margin-right: 4px; padding: 9px 16px; font-size: 15px; white-space: nowrap; }
.modal-close { width: 42px; height: 42px; padding: 0; }
.panel-body { flex-grow: 1; min-height: 0; padding: 0 24px 24px; }
.galaxy-scroll { flex-grow: 1; min-height: 0; }
.galaxy-scroll .unity-scroll-view__content-container { flex-grow: 1; }
.galaxy-scroll .unity-scroller--vertical { width: 10px; min-width: 10px; background-color: transparent; }
.galaxy-scroll .unity-scroller__high-button, .galaxy-scroll .unity-scroller__low-button { display: none; }
.galaxy-scroll .unity-base-slider__dragger { background-color: var(--bd); border-width: 0; border-radius: 5px; min-width: 5px; width: 5px; }
.galaxy-scroll .unity-base-slider__tracker { background-color: transparent; border-width: 0; }
.galaxy-slider { width: 270px; height: 34px; padding: 0 12px; justify-content: center; flex-shrink: 0; }
.slider-track { width: 100%; height: 12px; position: relative; }
.slider-fill { position: absolute; top: 0; bottom: 0; left: 0; }
.slider-knob { position: absolute; top: -7px; width: 26px; height: 26px; translate: -50% 0; align-items: center; justify-content: center; }
.slider-knob.dragging { scale: 1.06 1.06; }
.slider-halo { position: absolute; left: -4px; right: -4px; top: -4px; bottom: -4px; border-width: 4px; border-radius: 17px; display: none; }
.slider-knob.dragging .slider-halo { display: flex; }
.slider-fill { transition-property: width; transition-duration: .15s; transition-timing-function: ease-out; }
.slider-knob { transition-property: left, scale; transition-duration: .15s, .12s; transition-timing-function: ease-out; }
.galaxy-slider.dragging .slider-fill, .galaxy-slider.dragging .slider-knob { transition-duration: 0s; }
.slider-dot { width: 8px; height: 8px; }
.progress-track { height: 10px; overflow: hidden; flex-shrink: 0; }
.progress-fill { height: 100%; }
.galaxy-tile { align-items: center; position: relative; }
.tile-tag { position: absolute; top: 70px; align-self: center; white-space: nowrap; }
.toast-layer { align-items: center; justify-content: flex-end; padding-bottom: 28px; }
.toast { padding: 10px 16px; }

.main-blocked .galaxy-button:disabled { opacity: 1; }

.closing-ghost .galaxy-button:disabled { opacity: 1; }

.mode-hover-ring { display: none; }
.mode-slot:hover .mode-hover-ring { display: flex; scale: 1.04 1.04; }
.mode-slot:hover .mode-selection-ring, .mode-slot:hover .mode-selection-gap { display: none; }
