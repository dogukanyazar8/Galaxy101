  "rules": [
    {
      "tr": [
        "Taşlar ve okey",
        [
          "Oyunda 106 taş var: kırmızı, sarı, mavi ve siyah renklerde 1'den 13'e kadar ikişer taş ve 2 sahte okey.",
          "Ortadan açılan taş göstergedir. Göstergenin bir üstü okeydir ve her taşın yerine geçebilir.",
          "Sahte okey, okeyin kendisi yerine kullanılır; değeri okeyin değeridir."
        ],
        "Gösterge sarı 7 ise okey sarı 8 olur."
      ],
      "en": [
        "Tiles and the okey",
        [
          "There are 106 tiles: two of each number from 1 to 13 in red, yellow, blue and black, plus 2 false okeys.",
          "The tile turned up in the middle is the indicator. The tile one above it is the okey and can stand in for any tile.",
          "A false okey takes the place of the okey itself and has the okey's value."
        ],
        "If the indicator is yellow 7, the okey is yellow 8."
      ],
      "tiles": [
        "Y7:g",
        "|",
        "Y8*:o"
      ]
    },
    {
      "tr": [
        "Dağıtım",
        [
          "Taşlar karıştırılır ve her oyuncuya 21 taş dağıtılır.",
          "Oyunu başlatan oyuncu 22 taş alır ve ilk hamlede bir taş atarak başlar.",
          "Kalan taşlar ortada çekme destesi olur. Sıra saat yönünün tersine ilerler."
        ],
        ""
      ],
      "en": [
        "Dealing",
        [
          "The tiles are shuffled and every player gets 21 tiles.",
          "The starting player gets 22 tiles and begins by discarding one.",
          "The remaining tiles form the draw pile in the middle. Play goes counter-clockwise."
        ],
        ""
      ],
      "tiles": []
    },
    {
      "tr": [
        "Elini açmak",
        [
          "Elini açabilmek için perlerinin toplamı en az 101 olmalı.",
          "Seri: aynı renkte en az 3 ardışık taş. Grup: aynı sayıda, farklı renklerde 3 veya 4 taş.",
          "İstersen en az 5 çiftle çiftten de açabilirsin."
        ],
        "Seri 46 + grup 36 = 82 puan. Açmak için 19 puan daha gerekir."
      ],
      "en": [
        "Opening your hand",
        [
          "To open your hand, your sets must add up to at least 101.",
          "Run: at least 3 consecutive tiles of the same color. Group: 3 or 4 tiles of the same number in different colors.",
          "You can also open with at least 5 pairs."
        ],
        "Run 46 + group 36 = 82 points. You need 19 more to open."
      ],
      "tiles": [
        "K10",
        "K11",
        "K12",
        "K13",
        "|",
        "B12",
        "R12",
        "Y12"
      ]
    },
    {
      "tr": [
        "Taş işlemek",
        [
          "Elini açtıktan sonra masadaki tüm perlere uygun taş ekleyebilirsin.",
          "Masadaki bir perde okeyin yerini tutan taş sende varsa, onu koyup okeyi alabilirsin."
        ],
        "Kırmızı 13'ü masadaki kırmızı seriye işleyebilirsin."
      ],
      "en": [
        "Adding tiles",
        [
          "Once you have opened, you can add matching tiles to any set on the table.",
          "If you hold the tile the okey stands for in a set on the table, you can swap it in and take the okey."
        ],
        "You can add red 13 to the red run on the table."
      ],
      "tiles": [
        "R10",
        "R11",
        "R12",
        "|",
        "R13*:a"
      ]
    },
    {
      "tr": [
        "Bitirmek",
        [
          "Elindeki tüm taşları perlere yerleştirip son taşını atan oyuncu eli bitirir.",
          "Son taş olarak okeyi atarak bitirirsen bütün cezalar ikiye katlanır."
        ],
        "Son taş olarak okeyi atmak cezaları ikiye katlar."
      ],
      "en": [
        "Finishing",
        [
          "The player who places all their tiles in sets and discards their last tile finishes the hand.",
          "If you finish by discarding the okey, every penalty is doubled."
        ],
        "Discarding the okey as your last tile doubles all penalties."
      ],
      "tiles": [
        "B5",
        "B6",
        "B7",
        "|",
        "Y8*:l"
      ]
    },
    {
      "tr": [
        "Puanlama",
        [
          "Eli bitiren oyuncu -101 puan alır.",
          "Elini açan oyuncular ellerinde kalan taşların toplamı kadar ceza alır.",
          "Elini açamayan oyuncu 202 ceza alır. Çiftten açanların cezası ikiye katlanır.",
          "Oyun sonunda en düşük puana sahip oyuncu kazanır."
        ],
        ""
      ],
      "en": [
        "Scoring",
        [
          "The player who finishes gets -101 points.",
          "Players who opened get a penalty equal to the sum of the tiles left in their hand.",
          "A player who never opened gets 202 penalty points. Players who opened with pairs get double penalties.",
          "The player with the lowest score at the end wins."
        ],
        ""
      ],
      "tiles": []
    }
  ],
