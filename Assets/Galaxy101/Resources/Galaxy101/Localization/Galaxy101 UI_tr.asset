    m_Metadata:
      m_Items: []
  - m_Id: 967102477
    m_Localized: "\xC7ip sat\u0131n al"
    m_Metadata:
      m_Items: []
  - m_Id: 967102478
    m_Localized: "Elmas sat\u0131n al"
    m_Metadata:
      m_Items: []
  - m_Id: 967102479
    m_Localized: "Oyuncu ID \xB7 4821 9930"
    m_Metadata:
      m_Items: []
  - m_Id: 967102480
    m_Localized: "Ba\u011Fl\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102481
    m_Localized: "\xC7\u0131k\u0131\u015F yap"
    m_Metadata:
      m_Items: []
  - m_Id: 967102482
    m_Localized: "Hesab\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 967102483
    m_Localized: "\xC7evrimd\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102484
    m_Localized: Oyun
    m_Metadata:
      m_Items: []
  - m_Id: 967102485
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 967102486
    m_Localized: "G\xF6r\xFCnt\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 967102487
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 967102488
    m_Localized: Hesap
    m_Metadata:
      m_Items: []
  - m_Id: 967102489
    m_Localized: "Ta\u015F hareketleri ve masa davran\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102490
    m_Localized: "M\xFCzik, efektler ve bildirim sesleri"
    m_Metadata:
      m_Items: []
  - m_Id: 967102491
    m_Localized: "Tema, \xE7\xF6z\xFCn\xFCrl\xFCk ve g\xF6rsel efektler"
    m_Metadata:
      m_Items: []
  - m_Id: 967102492
    m_Localized: "Uygulaman\u0131n dili"
    m_Metadata:
      m_Items: []
  - m_Id: 967102493
    m_Localized: "Profil, ba\u011Fl\u0131 hesaplar ve bildirimler"
    m_Metadata:
      m_Items: []
  - m_Id: 967102494
    m_Localized: "Otomatik s\u0131rala"
    m_Metadata:
      m_Items: []
  - m_Id: 967102495
    m_Localized: "Yeni \xE7ekilen ta\u015F \u0131stakada uygun yere yerle\u015Fsin"
    m_Metadata:
      m_Items: []
  - m_Id: 967102496
    m_Localized: Perleri vurgula
    m_Metadata:
      m_Items: []
  - m_Id: 967102497
    m_Localized: "Ge\xE7erli perlerin \xE7evresi ye\u015Fil yans\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 967102498
    m_Localized: "\xC7ift t\u0131kla ta\u015F at"
    m_Metadata:
      m_Items: []
  - m_Id: 967102499
    m_Localized: "S\xFCr\xFCklemeden h\u0131zl\u0131 at\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 967102500
    m_Localized: Masa sohbeti
    m_Metadata:
      m_Items: []
  - m_Id: 967102501
    m_Localized: "Masa i\xE7i mesaj ve emojiler g\xF6r\xFCns\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 967102502
    m_Localized: "Tur s\xFCresi uyar\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102503
    m_Localized: "S\xFCre bitmeden ka\xE7 saniye \xF6nce uyar\u0131ls\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 967102504
    m_Localized: "Ta\u015F boyutu"
    m_Metadata:
      m_Items: []
  - m_Id: 967102505
    m_Localized: "Istakadaki ta\u015Flar\u0131n b\xFCy\xFCkl\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 967102506
    m_Localized: "K\xFC\xE7\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 967102507
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 967102508
    m_Localized: "B\xFCy\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 967102509
    m_Localized: Ana ses
    m_Metadata:
      m_Items: []
  - m_Id: 967102510
    m_Localized: "T\xFCm seslerin genel seviyesi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102511
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 967102512
    m_Localized: "Men\xFC ve masa m\xFCzi\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102513
    m_Localized: Efektler
    m_Metadata:
      m_Items: []
  - m_Id: 967102514
    m_Localized: "Ta\u015F, zar ve buton sesleri"
    m_Metadata:
      m_Items: []
  - m_Id: 967102515
    m_Localized: "Ta\u015F sesleri"
    m_Metadata:
      m_Items: []
  - m_Id: 967102516
    m_Localized: "Ta\u015F \xE7ekme ve atma sesi"
    m_Metadata:
      m_Items: []
  - m_Id: 967102517
    m_Localized: Bildirim sesi
    m_Metadata:
      m_Items: []
  - m_Id: 967102518
    m_Localized: "S\u0131ra sende ve davet uyar\u0131lar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102519
    m_Localized: Arka plan hareketi
    m_Metadata:
      m_Items: []
  - m_Id: 967102520
    m_Localized: "D\xF6nen gezegen ve kayan y\u0131ld\u0131zlar"
    m_Metadata:
      m_Items: []
  - m_Id: 967102521
    m_Localized: "\xC7\xF6z\xFCn\xFCrl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 967102522
    m_Localized: Ekran boyutu
    m_Metadata:
      m_Items: []
  - m_Id: 967102523
    m_Localized: Efekt kalitesi
    m_Metadata:
      m_Items: []
  - m_Id: 967102524
    m_Localized: "D\xFC\u015F\xFCk ayar eski bilgisayarlarda ak\u0131c\u0131l\u0131\u011F\u0131 art\u0131r\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 967102525
    m_Localized: "D\xFC\u015F\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 967102526
    m_Localized: "Y\xFCksek"
    m_Metadata:
      m_Items: []
  - m_Id: 967102527
    m_Localized: "Arkada\u015Fl\u0131k istekleri"
    m_Metadata:
      m_Items: []
  - m_Id: 967102528
    m_Localized: "Yeni istekler i\xE7in bildirim al"
    m_Metadata:
      m_Items: []
  - m_Id: 967102529
