# Server (.NET): project files are hand-written here, unlike Unity's generated ones
!/Server/**/*.csproj
!/Server/*.slnx
!/Shared/**/*.csproj
/Server/**/bin/
/Server/**/obj/
/Shared/**/bin/
/Shared/**/obj/
/Server/**/TestResults/

# Local server signing key (scripts/Start-LocalServer.ps1)
/Server/.devkey
