  - m_Id: 967102604
    m_Localized: "AVATAR RENG\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 967102605
    m_Localized: "Oyuncu ad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 967102606
    m_Localized: "Masadaki di\u011Fer oyuncular bu ad\u0131 g\xF6r\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 967102607
    m_Localized: "3\u201316 karakter: harf, rakam, bo\u015Fluk, nokta veya alt \xE7izgi."
    m_Metadata:
      m_Items: []
  - m_Id: 967102608
    m_Localized: "Durum mesaj\u0131"
